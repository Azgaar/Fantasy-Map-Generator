{
  "name": "fantasy-map-generator",
  "version": "1.143.3",
  "description": "Azgaar's _Fantasy Map Generator_ is a free web application that helps fantasy writers, game masters, and cartographers create and edit fantasy maps.",
  "homepage": "https://github.com/Azgaar/Fantasy-Map-Generator#readme",
  "bugs": {
    "url": "https://github.com/Azgaar/Fantasy-Map-Generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azgaar/Fantasy-Map-Generator.git"
  },
  "license": "MIT",
  "author": "Azgaar",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-bundle-size.mts",
    "build:viewer": "tsc && vite build --config config/vite.viewer.config.ts",
    "benchmark:renderer": "playwright test --config=tests/benchmarks/playwright.config.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:exploratory": "playwright test --config=tests/exploratory/playwright.config.ts",
    "lint": "biome check --write",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@playwright/test": "^1.57.0",
    "@types/d3": "^7.4.3",
    "@types/delaunator": "^5.0.3",
    "@types/lineclip": "^2.0.0",
    "@types/node": "^25.0.10",
    "@types/polylabel": "^1.1.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.0.18",
    "playwright": "^1.57.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@patkepa/kantzen-ui": "^0.1.0",
    "alea": "^1.0.1",
    "d3": "^7.9.0",
    "delaunator": "^5.0.1",
    "lineclip": "^2.0.0",
    "pixi.js": "^8.19.0",
    "polylabel": "^2.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
